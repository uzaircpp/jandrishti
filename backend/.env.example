# ============================================================
# JanDrishti - live collector credentials
# Copy this file to  backend/.env  and fill in the keys you have.
# Any platform you leave blank is skipped. With none set, the app
# runs on the synthetic demo data.
# ============================================================

# --- Reddit (easiest) --- https://www.reddit.com/prefs/apps  -> create "script" app
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=JanDrishti/0.1 by your_username
# comma-separated; "popular" = current viral. e.g. popular,india,unitedstatesofindia,worldnews
REDDIT_SUBREDDITS=popular,india,worldnews

# --- YouTube --- https://console.cloud.google.com -> enable "YouTube Data API v3" -> API key
YOUTUBE_API_KEY=
YOUTUBE_REGION=IN

# --- Telegram --- https://my.telegram.org -> API development tools
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# comma-separated public channels (no @). e.g. indiatoday,ndtv,ani_news
TELEGRAM_CHANNELS=
# one-time: run  python telegram_login.py  to create the login session
